{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scaf:schema:controlled-context-package:v0.0.10rc04",
  "title": "SCAF Controlled Context Package v0.0.10rc03 Representation Contract Schema Foundation",
  "description": "Structural parsed-instance schema foundation for the accepted v0.0.10rc03 Controlled Context Package YAML representation. This schema validates representation identity, required/optional members, closed object shapes, bounded token vocabularies, branch-specific materialization shapes, non-empty strings/lists, and lowercase SHA-256 syntax only. It does not prove exact upstream bytes, accepted upstream validation, validated-I coverage, Association Envelope fidelity, package-local reference integrity, one-decision-per-accepted-association accounting, decision/provenance correspondence, canonical physical YAML ordering, source loading/currentness, engineering-context sufficiency, verification, compliance, risk acceptance, release, closure, builder determinism, or consumer/model behavior.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "package_kind",
    "representation_release",
    "upstream_binding",
    "assembly_objective",
    "authority_context_entries",
    "materialized_context_items"
  ],
  "properties": {
    "package_kind": {
      "const": "controlled_context_package"
    },
    "representation_release": {
      "const": "v0.0.10rc03"
    },
    "upstream_binding": {
      "$ref": "#/$defs/upstreamBinding"
    },
    "assembly_objective": {
      "$ref": "#/$defs/assemblyObjective"
    },
    "authority_context_entries": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/authorityContextEntry"
      }
    },
    "materialized_context_items": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/materializedContextItem"
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "lowercaseSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "consumptionSelectionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_sha256",
        "selection_kind",
        "representation_release",
        "project_scope_ref"
      ],
      "properties": {
        "source_sha256": {
          "$ref": "#/$defs/lowercaseSha256"
        },
        "selection_kind": {
          "const": "consumption_selection"
        },
        "representation_release": {
          "const": "v0.0.7rc03"
        },
        "project_scope_ref": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "contextSourceAssociationSetBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_sha256",
        "association_set_kind",
        "representation_release",
        "consumption_selection_source_sha256",
        "project_scope_ref"
      ],
      "properties": {
        "source_sha256": {
          "$ref": "#/$defs/lowercaseSha256"
        },
        "association_set_kind": {
          "const": "context_source_association_set"
        },
        "representation_release": {
          "const": "v0.0.9rc03"
        },
        "consumption_selection_source_sha256": {
          "$ref": "#/$defs/lowercaseSha256"
        },
        "project_scope_ref": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "upstreamBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumption_selection",
        "context_source_association_set"
      ],
      "properties": {
        "consumption_selection": {
          "$ref": "#/$defs/consumptionSelectionBinding"
        },
        "context_source_association_set": {
          "$ref": "#/$defs/contextSourceAssociationSetBinding"
        }
      }
    },
    "assemblyObjective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective_id",
        "objective_statement"
      ],
      "properties": {
        "objective_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "objective_statement": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "associationAssertionKind": {
      "enum": [
        "framework_declared",
        "project_declared",
        "controlled_rule_derived"
      ]
    },
    "relationshipSemantic": {
      "enum": [
        "framework_obligation_source",
        "project_decision_source",
        "realization_source",
        "verification_definition_source",
        "verification_evidence_source",
        "external_constraint_source",
        "supporting_context_source"
      ]
    },
    "associationProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assertion_kind",
        "basis_refs"
      ],
      "properties": {
        "assertion_kind": {
          "$ref": "#/$defs/associationAssertionKind"
        },
        "basis_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "authorityQualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qualification_kind",
        "authority_scope_ref",
        "authority_basis_refs"
      ],
      "properties": {
        "qualification_kind": {
          "const": "authoritative_for_relationship_scope"
        },
        "authority_scope_ref": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "authority_basis_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "instanceConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constraint_kind",
        "value"
      ],
      "properties": {
        "constraint_kind": {
          "const": "sha256"
        },
        "value": {
          "$ref": "#/$defs/lowercaseSha256"
        }
      }
    },
    "controlledSourceAssociation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_unit_ref",
        "relationship_semantic",
        "relationship_scope_ref",
        "association_provenance"
      ],
      "properties": {
        "source_unit_ref": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "relationship_semantic": {
          "$ref": "#/$defs/relationshipSemantic"
        },
        "relationship_scope_ref": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "association_provenance": {
          "$ref": "#/$defs/associationProvenance"
        },
        "authority_qualification": {
          "$ref": "#/$defs/authorityQualification"
        },
        "instance_constraint": {
          "$ref": "#/$defs/instanceConstraint"
        }
      }
    },
    "associationEnvelopeEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "association_handle",
        "controlled_association"
      ],
      "properties": {
        "association_handle": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "controlled_association": {
          "$ref": "#/$defs/controlledSourceAssociation"
        }
      }
    },
    "materializedDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "association_handle",
        "outcome",
        "materialized_context_item_refs"
      ],
      "properties": {
        "association_handle": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "outcome": {
          "const": "materialized"
        },
        "materialized_context_item_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "notMaterializedDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "association_handle",
        "outcome",
        "materialized_context_item_refs",
        "non_materialization_basis"
      ],
      "properties": {
        "association_handle": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "outcome": {
          "const": "not_materialized"
        },
        "materialized_context_item_refs": {
          "type": "array",
          "maxItems": 0
        },
        "non_materialization_basis": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "materializationDecision": {
      "oneOf": [
        {
          "$ref": "#/$defs/materializedDecision"
        },
        {
          "$ref": "#/$defs/notMaterializedDecision"
        }
      ]
    },
    "authorityContextEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scaf_authority_id",
        "association_envelope",
        "materialization_decisions"
      ],
      "properties": {
        "scaf_authority_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "association_envelope": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/associationEnvelopeEntry"
          }
        },
        "materialization_decisions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/materializationDecision"
          }
        }
      }
    },
    "controlledProvenanceBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scaf_authority_id",
        "association_handle"
      ],
      "properties": {
        "scaf_authority_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "association_handle": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "sourceReferencePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payload_kind",
        "source_identity_ref"
      ],
      "properties": {
        "payload_kind": {
          "const": "source_reference"
        },
        "source_identity_ref": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "materializedContextItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "materialized_context_item_id",
        "context_semantic",
        "controlled_provenance_bases",
        "payload"
      ],
      "properties": {
        "materialized_context_item_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "context_semantic": {
          "enum": [
            "source_preserving",
            "derived"
          ]
        },
        "controlled_provenance_bases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/controlledProvenanceBasis"
          }
        },
        "payload": {
          "$ref": "#/$defs/sourceReferencePayload"
        }
      }
    }
  }
}
